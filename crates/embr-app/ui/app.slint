// Embr — the main window.
//
// The look is the one the spike settled on: dark palette tokens, rounded cards, stat tiles,
// real std-widgets, battery bars. This file draws and raises callbacks; it decides nothing.
// Every string that needs judgement (ages, percentages with their `~`, the thresholds as a
// sentence) is computed in Rust by `core` and handed in as a property.

import { Palette, ScrollView, SpinBox, Switch, Button, AboutSlint } from "std-widgets.slint";

export struct Device {
    key: string,
    name: string,
    kind: string,
    connection: string,
    /// -1 when the device reported no level at all.
    percent: int,
    /// `88%`, `~88%` (estimated) or `—`.
    percent-text: string,
    has-percent: bool,
    millivolts: int,
    status: string,
    attention: bool,
    updated: string,
    /// The level this device alerts at: its own, or the highest shared threshold.
    alert-below: int,
    /// True when that level is one the user set for this device alone.
    alert-below-custom: bool,
    error: string,
}

/// One device as the settings page offers it: a switch that gives it a tray icon of its own.
export struct TrayChoice {
    key: string,
    name: string,
    /// How it is connected, so two devices with the same name can be told apart.
    caption: string,
    /// Whether this device has an icon of its own right now.
    on: bool,
}

/// One option on the tray-icon picker: a style, and the picture the bar would draw for it.
///
/// The picture is the tray's own pixmap, made in Rust, so the picker shows the icon itself rather
/// than a redrawing of it — a picker that offers something the tray does not draw would be worse
/// than no picker at all.
export struct TrayStyleOption {
    /// The name written in the configuration, and what a click reports: `battery`, `percent`, …
    id: string,
    label: string,
    /// One line on what the style draws.
    caption: string,
    preview: image,
    on: bool,
}

/// One colour the percentage style's text can be drawn in. The only coloured thing the tray icon
/// has, so it is the only picker of its kind.
export struct TrayColorOption {
    /// The name written in the configuration, and what a click reports: `level`, `white`, …
    id: string,
    label: string,
    /// The colour itself, for the dot on the tile.
    swatch: color,
    on: bool,
}

global Tokens {
    out property <color> bg: #15161a;
    out property <color> surface: #1c1e23;
    out property <color> surface-raised: #23262c;
    out property <color> track: #303439;
    out property <color> border-subtle: #2b2f36;
    out property <color> text-primary: #e7e9ec;
    out property <color> text-secondary: #9ba1a9;
    out property <color> text-tertiary: #6c737c;
    out property <color> accent: #5aa9f7;
    out property <color> green: #3ddc97;
    out property <color> amber: #f4c150;
    out property <color> red: #f2726f;
    out property <color> blue: #6aa8ff;
    /// Muted red, for a row that wants attention: a tint of the surface, not a shout.
    out property <color> alert-surface: #291d1f;
    out property <color> alert-surface-raised: #332325;

    /// Receiver families are told apart by colour, as in the spike.
    public pure function conn-color(c: string) -> color {
        if (c.starts-with("Lightspeed")) { return blue; }
        if (c.starts-with("Bolt")) { return green; }
        if (c == "USB" || c == "Bluetooth") { return accent; }
        return text-secondary;
    }

    public pure function status-color(s: string) -> color {
        if (s == "Discharging") { return amber; }
        if (s == "Charging" || s == "Slow charging" || s == "Almost full" || s == "Full") { return green; }
        if (s == "Battery fault" || s == "Thermal fault") { return red; }
        return text-tertiary;
    }

    public pure function bar-color(has-percent: bool, s: string, p: int) -> color {
        if (!has-percent) { return track; }
        if (s == "Battery fault" || s == "Thermal fault") { return red; }
        if (p <= 20) { return red; }
        if (p <= 30) { return amber; }
        if (s == "Charging" || s == "Slow charging" || s == "Almost full" || s == "Full") { return blue; }
        return green;
    }
}

component Badge inherits Rectangle {
    in property <string> label;
    in property <color> tint: Tokens.text-secondary;

    height: 20px;
    width: badge-text.preferred-width + 16px;
    border-radius: 10px;
    background: tint.with-alpha(0.14);
    border-width: 1px;
    border-color: tint.with-alpha(0.28);

    badge-text := Text {
        text: label;
        font-size: 10px;
        font-weight: 700;
        color: tint;
        letter-spacing: 0.4px;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: 100%;
    }
}

/// The device-kind glyph that leads each row. Drawn from primitives so the app ships no icon
/// assets and the shape scales with the row: outlines are Rectangles, the headset band is a
/// Path, and circles are Rectangles with a radius of half their side.
component DeviceGlyph inherits Rectangle {
    in property <string> kind;
    in property <color> tint: Tokens.text-secondary;

    width: 24px;
    height: 24px;
    background: transparent;

    if (kind == "Mouse") : Rectangle {
        background: transparent;
        Rectangle {
            x: 7px; y: 2.5px; width: 10px; height: 19px; border-radius: 5px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 11.2px; y: 5.5px; width: 1.6px; height: 5px; border-radius: 0.8px; background: tint; }
    }
    if (kind == "Keyboard") : Rectangle {
        background: transparent;
        Rectangle {
            x: 1px; y: 5px; width: 22px; height: 14px; border-radius: 3px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 4.5px; y: 9px; width: 15px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 4.5px; y: 13px; width: 3px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 10.5px; y: 13px; width: 3px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 16.5px; y: 13px; width: 3px; height: 1.6px; border-radius: 0.8px; background: tint; }
    }
    if (kind == "Headset") : Rectangle {
        background: transparent;
        Path {
            commands: "M 3 15 Q 12 3 21 15";
            stroke: tint;
            stroke-width: 2px;
            fill: transparent;
        }
        Rectangle { x: 1.5px; y: 13px; width: 4.5px; height: 7.5px; border-radius: 2.2px; background: tint; }
        Rectangle { x: 18px; y: 13px; width: 4.5px; height: 7.5px; border-radius: 2.2px; background: tint; }
    }
    if (kind == "Trackball") : Rectangle {
        background: transparent;
        Rectangle {
            x: 3px; y: 3px; width: 18px; height: 18px; border-radius: 9px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 9.5px; y: 9.5px; width: 5px; height: 5px; border-radius: 2.5px; background: tint; }
    }
    if (kind == "Touchpad") : Rectangle {
        background: transparent;
        Rectangle {
            x: 2px; y: 4.5px; width: 20px; height: 15px; border-radius: 3px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 6px; y: 15px; width: 12px; height: 1.6px; border-radius: 0.8px; background: tint; }
    }
    if (kind == "Numpad") : Rectangle {
        background: transparent;
        Rectangle {
            x: 5px; y: 2.5px; width: 14px; height: 19px; border-radius: 3px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        // Three rows of two keys, drawn explicitly: a nested `for` is not expressible in one
        // `if` branch, and six rectangles read better than a loop here anyway.
        Rectangle { x: 8px; y: 6px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 13px; y: 6px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 8px; y: 11px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 13px; y: 11px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 8px; y: 16px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 13px; y: 16px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
    }
    if (kind == "Presenter") : Rectangle {
        background: transparent;
        Rectangle {
            x: 7.5px; y: 2.5px; width: 9px; height: 19px; border-radius: 4.5px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 10px; y: 7px; width: 4px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 10px; y: 15px; width: 4px; height: 2.6px; border-radius: 1.3px; background: tint; }
    }
    if (kind == "Remote") : Rectangle {
        background: transparent;
        Rectangle {
            x: 7.5px; y: 2.5px; width: 9px; height: 19px; border-radius: 4.5px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 10.4px; y: 6px; width: 3.2px; height: 3.2px; border-radius: 1.6px; background: tint; }
        Rectangle { x: 10.4px; y: 12px; width: 3.2px; height: 3.2px; border-radius: 1.6px; background: tint; }
    }
    // Anything we cannot name yet gets a plain box rather than a guessed shape.
    if (kind == "Device" || kind == "") : Rectangle {
        background: transparent;
        Rectangle {
            x: 4px; y: 4px; width: 16px; height: 16px; border-radius: 4px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
    }
}

component BatteryBar inherits Rectangle {
    in property <int> percent;
    in property <color> fill-color: Tokens.green;

    height: 6px;
    border-radius: 3px;
    background: Tokens.track;

    // `x: 0` is load-bearing: a child Rectangle that sets only `width` is centred inside its
    // parent, which makes a progress bar shrink from both ends instead of from the right.
    Rectangle {
        x: 0;
        y: 0;
        width: max(0px, parent.width * percent / 100);
        height: parent.height;
        border-radius: 3px;
        background: fill-color;
    }
}

/// One device in the list: the glyph, the name, the level and what the device is doing.
///
/// The connection type and the Snooze action are *not* here. The badge is the widest thing a row
/// could carry and the least useful — it never changes — and with it gone the name fits the
/// narrowest the list is allowed to be; both moved into the details card, which is where a device
/// is read before anything is done about it.
component DeviceRow inherits Rectangle {
    in property <Device> device;
    in property <bool> is-selected: false;
    callback pick;

    height: 96px;
    border-radius: 12px;
    background: device.attention
        ? (is-selected ? Tokens.alert-surface-raised : Tokens.alert-surface)
        : (is-selected ? Tokens.surface-raised : Tokens.surface);
    border-width: 1px;
    border-color: device.attention
        ? Tokens.red.with-alpha(0.35)
        : (is-selected ? Tokens.accent.with-alpha(0.55) : Tokens.border-subtle);
    animate background, border-color { duration: 120ms; }

    // Declared before the content so a row is one big click target.
    row-click := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        cross-axis-alignment: center;

        // The tile keeps the connection family's colour, so the list still says at a glance how a
        // device is attached even though the badge is gone.
        Rectangle {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: Tokens.conn-color(device.connection).with-alpha(0.13);
            border-width: 1px;
            border-color: Tokens.conn-color(device.connection).with-alpha(0.25);

            DeviceGlyph {
                kind: device.kind;
                tint: Tokens.conn-color(device.connection);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            alignment: center;

            // The name gets the whole width of the row now. A long one still elides — that is what
            // this does when a name is longer than any window — but nothing competes with it.
            Text {
                text: device.name;
                font-size: 14px;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 10px;
                cross-axis-alignment: center;

                BatteryBar {
                    horizontal-stretch: 1;
                    percent: max(0, device.percent);
                    fill-color: Tokens.bar-color(device.has-percent, device.status, device.percent);
                }

                Text {
                    text: device.percent-text;
                    width: 52px;
                    font-size: 12px;
                    font-weight: 600;
                    color: device.attention ? Tokens.red : Tokens.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Tokens.status-color(device.status);
                }

                Text {
                    text: device.status;
                    font-size: 12px;
                    color: Tokens.status-color(device.status);
                    vertical-alignment: center;
                }

                Text {
                    text: device.kind;
                    font-size: 12px;
                    color: Tokens.text-tertiary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: device.updated;
                    font-size: 11px;
                    color: Tokens.text-tertiary;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Tokens.text-primary;

    height: 60px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.border-subtle;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 3px;
        alignment: center;

        Text {
            text: label;
            font-size: 10px;
            font-weight: 600;
            color: Tokens.text-tertiary;
            letter-spacing: 0.5px;
        }

        Text {
            text: value;
            font-size: 15px;
            font-weight: 600;
            color: value-color;
            overflow: elide;
        }
    }
}

component DetailLine inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 26px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        Text {
            text: label;
            width: 108px;
            font-size: 12px;
            color: Tokens.text-tertiary;
            vertical-alignment: center;
        }

        Text {
            text: value;
            font-size: 12px;
            color: Tokens.text-primary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    /// A second, smaller line inside the row: what the setting means, rather than a sentence
    /// floating between the rows.
    in property <string> caption: "";
    in property <string> value;
    in property <bool> with-switch: false;
    /// Give this a label to put a button on the right instead of a value or a switch.
    in property <string> button-text: "";
    /// What the row sits on: raised when it stands on the page by itself, transparent inside a
    /// card, where the card is the surface.
    in property <brush> fill: Tokens.surface-raised;
    in-out property <bool> toggled: false;
    callback changed(bool);
    callback acted;

    height: 44px;
    border-radius: 10px;
    background: fill;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: root.title;
                font-size: 13px;
                color: Tokens.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.caption != "": Text {
                text: root.caption;
                font-size: 10px;
                color: Tokens.text-tertiary;
                overflow: elide;
            }
        }

        if with-switch: Switch {
            checked <=> root.toggled;
            toggled => { root.changed(self.checked); }
        }

        if !with-switch && button-text == "": Text {
            text: value;
            font-size: 13px;
            color: Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        if !with-switch && button-text != "": Button {
            text: root.button-text;
            width: 128px;
            height: 28px;
            clicked => { root.acted(); }
        }
    }
}

/// The small grey label a settings page groups its rows under.
component SectionLabel inherits Text {
    font-size: 10px;
    font-weight: 700;
    color: Tokens.text-tertiary;
    letter-spacing: 0.6px;
}

/// A settings row whose value the user moves rather than reads.
component NumberRow inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <int> minimum: 5;
    in property <int> maximum: 600;
    in property <int> step: 5;
    in property <brush> fill: Tokens.surface-raised;
    in-out property <int> number: 60;
    callback numbered(int);

    height: 44px;
    border-radius: 10px;
    background: fill;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: root.title;
                font-size: 13px;
                color: Tokens.text-primary;
            }

            Text {
                text: root.caption;
                font-size: 10px;
                color: Tokens.text-tertiary;
                overflow: elide;
            }
        }

        SpinBox {
            width: 116px;
            height: 28px;
            minimum: root.minimum;
            maximum: root.maximum;
            step-size: root.step;
            value <=> root.number;
            edited(v) => { root.numbered(v); }
        }
    }
}

/// The sentence under a settings row that says what the row above it means. The rows stretch with
/// the window; a sentence that did too would be an unreadable 2500 px line, so it stops at a
/// comfortable measure and stays where the row starts.
component Caption inherits Text {
    font-size: 10px;
    color: Tokens.text-tertiary;
    wrap: word-wrap;
    max-width: 1080px;
}

/// A settings row whose switch belongs to the configuration rather than to the window: it shows
/// what the last snapshot said, and a click is *reported* instead of being stored here. That is
/// what lets a row exist per device without the window keeping a copy of the choice.
component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <bool> on: false;
    in property <brush> fill: Tokens.surface-raised;
    callback chosen(bool);

    height: 44px;
    border-radius: 10px;
    background: fill;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: root.title;
                font-size: 13px;
                color: Tokens.text-primary;
                overflow: elide;
            }

            Text {
                text: root.caption;
                font-size: 10px;
                color: Tokens.text-tertiary;
                overflow: elide;
            }
        }

        Switch {
            checked: root.on;
            toggled => { root.chosen(self.checked); }
        }
    }
}

/// The alert level of the selected device: the one setting in this window that is about one
/// device rather than the application, so it is edited here and its state says whose it is.
component AlertLevelRow inherits Rectangle {
    in property <string> default-text;
    in property <bool> custom: false;
    in-out property <int> level: 20;
    callback leveled(int);
    callback cleared();

    height: 44px;
    border-radius: 10px;
    background: Tokens.surface-raised;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: "Low battery alert";
                font-size: 13px;
                color: Tokens.text-primary;
            }

            // Whose level this is, in the row itself: a setting that belongs to one device is
            // otherwise indistinguishable from the shared ones below it.
            Text {
                text: root.custom ? "set for this device" : root.default-text;
                font-size: 10px;
                color: root.custom ? Tokens.accent : Tokens.text-tertiary;
                overflow: elide;
            }
        }

        SpinBox {
            width: 116px;
            height: 28px;
            minimum: 5;
            maximum: 95;
            step-size: 5;
            value <=> root.level;
            edited(v) => { root.leveled(v); }
        }

        Button {
            text: "Default";
            width: 78px;
            height: 28px;
            // Nothing to go back to when this device is already on the shared thresholds.
            enabled: root.custom;
            clicked => { root.cleared(); }
        }
    }
}

/// Snooze, for the selected device. It sits with that device's alert level rather than on every
/// row: it is something you do about *this* device after reading its numbers, not a column of
/// identical buttons to aim at in a list.
component SnoozeRow inherits Rectangle {
    in property <string> caption;
    callback snoozed;

    height: 44px;
    border-radius: 10px;
    background: Tokens.surface-raised;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: "Snooze alerts";
                font-size: 13px;
                color: Tokens.text-primary;
            }

            Text {
                text: root.caption;
                font-size: 10px;
                color: Tokens.text-tertiary;
                overflow: elide;
            }
        }

        Button {
            text: "Snooze";
            width: 78px;
            height: 28px;
            clicked => { root.snoozed(); }
        }
    }
}

/// A hairline between two rows of one card. The rows themselves are flat, so this is the only
/// thing that says where one ends and the next begins.
component RowSeparator inherits Rectangle {
    height: 1px;
    background: Tokens.border-subtle;
}

/// A group of settings under one heading.
///
/// The card is what makes the page read as sections rather than as a stack of loose pills: its own
/// surface, its own heading, and the rows inside it flat (`fill: transparent`) and separated by
/// hairlines. Its content is the instantiating file's: a card takes its children here.
component SettingsCard inherits Rectangle {
    in property <string> title;
    /// A sentence under the heading, when the section as a whole needs one.
    in property <string> caption: "";

    background: Tokens.surface;
    border-radius: 14px;
    border-width: 1px;
    border-color: Tokens.border-subtle;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 13px;
        padding-bottom: 13px;
        spacing: 8px;

        SectionLabel { text: root.title; }

        if root.caption != "": Caption { text: root.caption; }

        @children
    }
}

/// One choice on the tray-icon picker: the icon a bar would draw, and what the style is called.
///
/// The picture is the tray's own pixmap at the size the bar draws it, so what is picked here is
/// exactly what appears in the tray — no preview of an idealised version of it.
component StyleTile inherits Rectangle {
    in property <string> label;
    in property <image> preview;
    in property <bool> on: false;
    callback picked;

    width: 108px;
    height: 78px;
    border-radius: 10px;
    background: on ? Tokens.accent.with-alpha(0.14) : Tokens.surface-raised;
    border-width: 1px;
    border-color: on ? Tokens.accent.with-alpha(0.55) : Tokens.border-subtle;
    animate background, border-color { duration: 120ms; }

    VerticalLayout {
        padding: 8px;
        spacing: 5px;
        alignment: center;

        // A layout puts a fixed-size child at the start of its cross axis, so the pictogram is
        // centred inside a full-width strip rather than stretched by the layout.
        Rectangle {
            height: 24px;
            background: transparent;

            Image {
                source: root.preview;
                width: 22px;
                height: 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            color: on ? Tokens.accent : Tokens.text-secondary;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

/// One colour on the text-colour picker: a dot of it, and its name.
component SwatchTile inherits Rectangle {
    in property <string> label;
    in property <color> swatch: #ffffff;
    in property <bool> on: false;
    callback picked;

    width: 80px;
    height: 62px;
    border-radius: 10px;
    background: on ? Tokens.accent.with-alpha(0.14) : Tokens.surface-raised;
    border-width: 1px;
    border-color: on ? Tokens.accent.with-alpha(0.55) : Tokens.border-subtle;
    animate background, border-color { duration: 120ms; }

    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: center;

        // A layout puts a fixed-size child at the start of its cross axis, so the dot is centred
        // inside a full-width strip.
        Rectangle {
            height: 20px;
            background: transparent;

            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.swatch;
                border-width: 1px;
                border-color: #00000044;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            color: on ? Tokens.accent : Tokens.text-secondary;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

export component AppWindow inherits Window {
    title: "Embr — Logitech devices";
    // Noto Sans is what `sans-serif` resolves to on the major distributions, so the window looks
    // native wherever it runs and needs no font shipping. If a system does not have it, Slint
    // falls back to that system's own default.
    default-font-family: "Noto Sans";
    icon: @image-url("../../../assets/embr.svg");
    // The size the window opens at. `preferred-` and not `width:`, deliberately: a plain
    // `width:` is a binding on the window's size, so it keeps *being* 1000 no matter what the
    // compositor does with the frame — the frame grows, the layout does not, and the extra space
    // is painted in the background colour. With a preferred size the window opens there and the
    // layout follows it wherever it is dragged afterwards.
    preferred-width: 1000px;
    // Tall enough for the detail card and every settings row, with slack: a `Window` with a
    // fixed height clips whatever does not fit and says nothing about it.
    preferred-height: 660px;
    // No `min-width`/`min-height`: one size per axis is all a `Window` accepts, so the floor
    // cannot sit here as well. It lives in the panes instead (`min-width` on the device list and
    // the detail pane); below roughly 700 px the two cannot both fit and the detail card clips.
    background: Tokens.bg;

    in property <[Device]> devices;
    in-out property <Device> selected;
    in property <bool> has-devices: false;
    in property <string> last-updated-label: "";
    in property <bool> refreshing: false;
    in-out property <bool> notifications-enabled: false;
    in property <string> thresholds-text: "";
    /// Seconds between the sweeps the window asks for while it is open. Rust clamps this to
    /// 5–600 before it lands here, and `core::scheduled_interval` is what does the counting.
    in-out property <int> refresh-seconds: 60;
    in property <string> notice: "";
    in-out property <int> selected-index: -1;
    /// The selected device's alert level, and whether it is one the user set for it.
    in-out property <int> alert-level: 20;
    in property <bool> alert-custom: false;
    /// `quiet about this device for 30 minutes`: what the Snooze row says it will do.
    in property <string> snooze-caption: "";
    /// The styles the tray icon can be drawn as, one tile each, with their previews.
    in property <[TrayStyleOption]> tray-styles: [];
    /// The colours its text can be drawn in — shown only when the style has any text.
    in property <[TrayColorOption]> tray-colors: [];
    /// Whether the chosen style has text at all: a colour picker under a style with no text would
    /// be a control that does nothing.
    in property <bool> tray-has-text: false;
    /// `Battery — the colour is the level: green, amber, red.`: what the chosen style draws.
    in property <string> tray-style-caption: "";
    /// The devices the settings page offers a tray icon for, one row each.
    in property <[TrayChoice]> tray-choices: [];
    /// Keep running (tray only) when the window is closed, or quit instead.
    in-out property <bool> close-to-tray: true;
    /// Ask each device whether it is still there between sweeps, while this window is open.
    in-out property <bool> watch-devices: true;
    /// Where the settings on the settings page are written, so the page can say so.
    in property <string> config-path: "";
    /// Which page is showing: 0 is the devices, 1 is the settings. This one is the window's
    /// own; nothing outside decides it.
    in-out property <int> view: 0;

    callback tick();
    /// Read every device now, with the longer waits a device that has been asleep needs.
    callback rescan();
    callback pick(int);
    callback snooze(string);
    callback notifications-toggled(bool);
    callback alert-level-changed(int);
    callback alert-level-cleared();
    /// One tray-icon style was picked.
    callback tray-style-chosen(string);
    /// One colour for the tray icon's text was picked.
    callback tray-text-color-chosen(string);
    /// One device asked for (or gave up) its own tray icon.
    callback tray-device-toggled(string, bool);
    callback close-to-tray-toggled(bool);
    /// The user turned the between-sweeps watch on or off.
    callback watch-devices-toggled(bool);
    callback refresh-seconds-changed(int);
    callback quit-requested();
    callback show-about();

    // The tick does all the timing: it drains what the device thread produced, keeps the ages
    // honest and decides when the next scheduled sweep is due. The cadence itself is
    // `core::scheduled_interval`, and the number lives in the settings.
    Timer {
        interval: 500ms;
        running: true;
        triggered => { root.tick(); }
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        // ---- header ----
        HorizontalLayout {
            height: 66px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 14px;
            cross-axis-alignment: center;

            // The mark and the wordmark read as one unit, so they sit closer to each other than the
            // header's own spacing. Nothing else belongs up here: a summary line next to the
            // window's own name was noise on top of the list right below it.
            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("../../../assets/embr.svg");
                    width: 22px;
                    height: 22px;
                    image-fit: contain;
                }

                Text {
                    text: "Embr";
                    font-size: 20px;
                    font-weight: 700;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Two pages: what the devices are doing, and how the app behaves. The active one
            // is filled, which is the only thing that says which page you are looking at.
            Button {
                text: "Devices";
                width: 92px;
                height: 30px;
                primary: root.view == 0;
                clicked => { root.view = 0; }
            }

            Button {
                text: "Settings";
                width: 92px;
                height: 30px;
                primary: root.view == 1;
                clicked => { root.view = 1; }
            }

            Button {
                text: root.refreshing ? "Rescanning…" : "Rescan";
                width: 116px;
                height: 30px;
                clicked => { root.rescan(); }
            }

            Button {
                text: "About";
                width: 84px;
                height: 30px;
                clicked => { root.show-about(); }
            }
        }

        Rectangle { height: 1px; background: Tokens.border-subtle; }

        // ---- body ----
        //
        // `if` rather than `visible:`: an invisible layout child is still laid out, which put
        // the settings page below the devices page instead of in its place.
        if root.view == 0: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 20px;

            // left: the device list. It grows with the window up to the width at which a row's
            // own content (glyph, name, bar, percentage, Snooze) is comfortable and then stops,
            // which is what Solaar's tree does. `horizontal-stretch` and not `parent.width`:
            // reading a layout parent's width here makes the solver size the page from its
            // children instead of the window, and the whole page stops at the window's opening
            // width while the window keeps growing around it.
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 380px;
                max-width: 470px;
                vertical-stretch: 1;
                spacing: 10px;

                HorizontalLayout {
                    height: 18px;
                    cross-axis-alignment: center;

                    Text {
                        text: "DEVICES";
                        font-size: 10px;
                        font-weight: 700;
                        color: Tokens.text-tertiary;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.refreshing ? "scanning…" : root.last-updated-label;
                        font-size: 11px;
                        color: Tokens.text-tertiary;
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    // The standard widget's `preferred-height` is 100 % of its parent, which makes
                    // this list demand as much height as it holds: with more devices than rows fit,
                    // that demand travels up through the panes and the window's layout ends up
                    // taller than the window — which is then clipped, and the rows below the fold
                    // cannot be scrolled to, because the scroll range is measured inside the
                    // inflated layout. Asking for no height at all, and taking the space the
                    // layout gives (the stretch above), is what keeps the geometry honest.
                    preferred-height: 0px;

                    VerticalLayout {
                        spacing: 10px;

                        for d[i] in root.devices: DeviceRow {
                            device: d;
                            is-selected: i == root.selected-index;
                            pick => { root.pick(i); }
                        }

                        if !root.has-devices: Rectangle {
                            height: 96px;
                            border-radius: 12px;
                            background: Tokens.surface;
                            border-width: 1px;
                            border-color: Tokens.border-subtle;

                            Text {
                                text: root.refreshing
                                    ? "Scanning for Logitech devices…"
                                    : "No Logitech devices found.";
                                font-size: 13px;
                                color: Tokens.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // right: details, then settings. Everything the window gains in width lands here —
            // the details are what benefits from it, which is also the shape Solaar settles on.
            VerticalLayout {
                horizontal-stretch: 2;
                // 380 + 20 + 260 is 660: the pair still fits inside a window 700 px wide, which is
                // the narrowest this layout is honest at (below it the card's right edge clips).
                min-width: 260px;
                vertical-stretch: 1;
                spacing: 16px;

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 14px;
                    background: Tokens.surface;
                    border-width: 1px;
                    border-color: Tokens.border-subtle;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 4px;

                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 18px;
                        padding-bottom: 18px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 46px;
                                height: 46px;
                                border-radius: 12px;
                                background: Tokens.accent.with-alpha(0.14);
                                border-width: 1px;
                                border-color: Tokens.accent.with-alpha(0.28);

                                DeviceGlyph {
                                    kind: root.selected.kind;
                                    tint: Tokens.accent;
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: root.has-devices ? root.selected.name : "No device selected";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Tokens.text-primary;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.has-devices ? root.selected.kind : "—";
                                    font-size: 12px;
                                    color: Tokens.text-tertiary;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.has-devices: Badge {
                                label: root.selected.connection;
                                tint: Tokens.conn-color(root.selected.connection);
                            }
                        }

                        Rectangle { height: 1px; background: Tokens.border-subtle; }

                        HorizontalLayout {
                            spacing: 10px;

                            StatTile {
                                label: "BATTERY";
                                value: root.selected.percent-text;
                                value-color: root.selected.attention
                                    ? Tokens.red
                                    : Tokens.bar-color(root.selected.has-percent, root.selected.status, root.selected.percent);
                            }

                            StatTile {
                                label: "VOLTAGE";
                                value: root.selected.millivolts > 0 ? "\{root.selected.millivolts} mV" : "—";
                            }

                            StatTile {
                                label: "UPDATED";
                                value: root.selected.updated;
                            }
                        }

                        BatteryBar {
                            percent: max(0, root.selected.percent);
                            fill-color: Tokens.bar-color(root.selected.has-percent, root.selected.status, root.selected.percent);
                        }

                        // Status is the one field the stat tiles above do not already carry;
                        // connection is the badge next to the title, and voltage is the tile,
                        // so repeating them here just makes the card noisy.
                        DetailLine { label: "Status"; value: root.selected.status; }
                        if (root.has-devices && root.selected.error != "") : DetailLine {
                            label: "Reported";
                            value: root.selected.error;
                        }

                        Rectangle { height: 1px; background: Tokens.border-subtle; }

                        SectionLabel { text: "ALERT FOR THIS DEVICE"; }

                        if root.has-devices: AlertLevelRow {
                            default-text: "shared: " + root.thresholds-text;
                            custom: root.alert-custom;
                            level <=> root.alert-level;
                            leveled(v) => { root.alert-level-changed(v); }
                            cleared => { root.alert-level-cleared(); }
                        }

                        if root.has-devices: SnoozeRow {
                            caption: root.snooze-caption;
                            snoozed => { root.snooze(root.selected.key); }
                        }

                        Caption {
                            text: "Every other setting — notifications, the tray icon, what closing the window does — is on the Settings page.";
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }
        }

        // ---- the settings page ----
        //
        // The devices page is about what the hardware is doing; this one is about the app.
        // Scrolled rather than stretched, so a setting added later pushes the page down instead
        // of pushing rows out of the window.
        // Full width on purpose. A row here is a label at the left and its control at the far
        // right, so the pane uses whatever width the window has rather than sitting in a fixed
        // column in the middle of it — the shape Solaar has when it is maximised.
        //
        // One card per subject, in the order of how likely somebody is to come here for it: the
        // tray icon first, then what the app says to you, then how often it asks, then what it
        // does with the window, and what it writes down.
        // The page *is* the scroll view, rather than a scroll view buried in two layouts: that is
        // the shape Slint's own widget expects, and with the extra layouts around it the widget
        // measured its own viewport wrongly — the scroll range came out short and the last card of
        // the page could not be reached. The pane's padding is the content's padding now.
        if root.view == 1: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 0;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 16px;

                        SettingsCard {
                            title: "TRAY ICON";
                            caption: "The pictures are the icons themselves, at the size your bar draws them.";

                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;

                                for option in root.tray-styles: StyleTile {
                                    label: option.label;
                                    preview: option.preview;
                                    on: option.on;
                                    picked => { root.tray-style-chosen(option.id); }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            Caption { text: root.tray-style-caption; }

                            if root.tray-has-text: HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;

                                for option in root.tray-colors: SwatchTile {
                                    label: option.label;
                                    swatch: option.swatch;
                                    on: option.on;
                                    picked => { root.tray-text-color-chosen(option.id); }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            if root.tray-has-text: Caption {
                                text: "The numbers are the only coloured part of the tray icon — every other style is a white line drawing.";
                            }

                            RowSeparator { }

                            Caption {
                                text: "Some bars draw only the tray items they have pinned — these register as “embr” and “embr-<device>”.";
                            }
                        }

                        SettingsCard {
                            title: "ONE ICON PER DEVICE";
                            caption: "Nothing chosen means one icon, following the device with the least charge.";

                            for choice in root.tray-choices: ChoiceRow {
                                title: choice.name;
                                caption: choice.caption;
                                on: choice.on;
                                fill: transparent;
                                chosen(v) => { root.tray-device-toggled(choice.key, v); }
                            }

                            if root.tray-choices.length == 0: Caption {
                                text: "No devices found yet. Each device gets a switch here as soon as one answers.";
                            }
                        }

                        SettingsCard {
                            title: "NOTIFICATIONS";

                            SettingRow {
                                title: "Battery notifications";
                                caption: "off until you ask for them";
                                with-switch: true;
                                fill: transparent;
                                toggled <=> root.notifications-enabled;
                                changed(v) => { root.notifications-toggled(v); }
                            }

                            RowSeparator { }

                            SettingRow {
                                title: "Shared thresholds";
                                caption: "the levels every device without one of its own alerts at";
                                value: root.thresholds-text;
                                fill: transparent;
                            }

                            Caption {
                                text: "A device with a level of its own watches that instead — set it beside the device itself, on the Devices page.";
                            }
                        }

                        SettingsCard {
                            title: "REFRESHING";

                            NumberRow {
                                title: "Refresh interval";
                                caption: "while the window is open";
                                minimum: 5;
                                maximum: 600;
                                step: 5;
                                fill: transparent;
                                number <=> root.refresh-seconds;
                                numbered(v) => { root.refresh-seconds-changed(v); }
                            }

                            RowSeparator { }

                            SettingRow {
                                title: "Notice a device going quiet";
                                caption: "one short question per device, every five seconds, while the window is open";
                                with-switch: true;
                                fill: transparent;
                                toggled <=> root.watch-devices;
                                changed(v) => { root.watch-devices-toggled(v); }
                            }

                            Caption {
                                text: "Closed, Embr slows to a read every two minutes and reads everything the moment the window comes back; Rescan reads now and waits longer for a device that has been asleep. The five-second watch is what notices a headset switched off behind its dongle — turn it off to leave the devices alone between refreshes.";
                            }
                        }

                        SettingsCard {
                            title: "WINDOW";

                            SettingRow {
                                title: "Close to tray";
                                caption: "closing the window keeps Embr watching in the background";
                                with-switch: true;
                                fill: transparent;
                                toggled <=> root.close-to-tray;
                                changed(v) => { root.close-to-tray-toggled(v); }
                            }

                            Caption {
                                text: "With this off, the close button quits. A low battery is still announced with nothing on screen, and the tray item is the way back.";
                            }

                            RowSeparator { }

                            SettingRow {
                                title: "Stop watching now";
                                caption: "quits Embr and takes the tray item with it";
                                button-text: "Quit Embr";
                                fill: transparent;
                                acted => { root.quit-requested(); }
                            }
                        }

                        SettingsCard {
                            title: "SETTINGS FILE";

                            SettingRow {
                                title: "Settings file";
                                value: root.config-path;
                                fill: transparent;
                            }

                            Caption {
                                text: "Written as you change things here. The thresholds and the per-device levels live in it too, so it can be edited by hand while Embr runs.";
                            }

                            if root.notice != "": Caption {
                                text: root.notice;
                            }
                        }
                    }
                    }
                }
            }
        }
    }

/// The About view. The `AboutSlint` widget is required by the Slint licence and is shown
/// here rather than buried, because this build really does use Slint under the hood.
export component AboutWindow inherits Window {
    title: "About Embr";
    default-font-family: "Noto Sans";
    icon: @image-url("../../../assets/embr.svg");
    width: 460px;
    // Tall enough for the mark, three lines of text, the Slint attribution and the button.
    height: 420px;
    background: Tokens.bg;

    callback close-requested();

    VerticalLayout {
        padding: 26px;
        spacing: 12px;
        alignment: center;

        Image {
            source: @image-url("../../../assets/embr.svg");
            width: 100%;
            height: 72px;
            image-fit: contain;
            // The layout stretches children across its cross axis, so the mark needs to say where
            // it sits inside that width.
            horizontal-alignment: center;
        }

        Text {
            text: "Embr";
            font-size: 22px;
            font-weight: 700;
            color: Tokens.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: "A battery monitor for Logitech devices on Linux.";
            font-size: 13px;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: "Reads the devices directly over HID++ and shows what they report — charge, voltage, connection state and the device list.";
            font-size: 12px;
            color: Tokens.text-tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        AboutSlint { }

        // A layout positions a fixed-width child at the start of its cross axis, so the button is
        // centred inside a full-width strip instead of stretching to the whole dialog.
        Rectangle {
            height: 30px;
            background: transparent;

            Button {
                text: "Close";
                width: 96px;
                height: 30px;
                x: (parent.width - self.width) / 2;
                clicked => { root.close-requested(); }
            }
        }
    }
}
