// Embr — the main window.
//
// The look is the one the spike settled on: dark palette tokens, rounded cards, stat tiles,
// real std-widgets, battery bars. This file draws and raises callbacks; it decides nothing.
// Every string that needs judgement (ages, percentages with their `~`, the thresholds as a
// sentence) is computed in Rust by `core` and handed in as a property.

import { Palette, ScrollView, SpinBox, Switch, Button, AboutSlint } from "std-widgets.slint";

export struct Device {
    key: string,
    name: string,
    kind: string,
    connection: string,
    /// -1 when the device reported no level at all.
    percent: int,
    /// `88%`, `~88%` (estimated) or `—`.
    percent-text: string,
    has-percent: bool,
    millivolts: int,
    status: string,
    attention: bool,
    updated: string,
    /// The level this device alerts at: its own, or the highest shared threshold.
    alert-below: int,
    /// True when that level is one the user set for this device alone.
    alert-below-custom: bool,
    error: string,
}

global Tokens {
    out property <color> bg: #15161a;
    out property <color> surface: #1c1e23;
    out property <color> surface-raised: #23262c;
    out property <color> track: #303439;
    out property <color> border-subtle: #2b2f36;
    out property <color> text-primary: #e7e9ec;
    out property <color> text-secondary: #9ba1a9;
    out property <color> text-tertiary: #6c737c;
    out property <color> accent: #5aa9f7;
    out property <color> green: #3ddc97;
    out property <color> amber: #f4c150;
    out property <color> red: #f2726f;
    out property <color> blue: #6aa8ff;
    /// Muted red, for a row that wants attention: a tint of the surface, not a shout.
    out property <color> alert-surface: #291d1f;
    out property <color> alert-surface-raised: #332325;

    /// Receiver families are told apart by colour, as in the spike.
    public pure function conn-color(c: string) -> color {
        if (c.starts-with("Lightspeed")) { return blue; }
        if (c.starts-with("Bolt")) { return green; }
        if (c == "USB" || c == "Bluetooth") { return accent; }
        return text-secondary;
    }

    public pure function status-color(s: string) -> color {
        if (s == "Discharging") { return amber; }
        if (s == "Charging" || s == "Slow charging" || s == "Almost full" || s == "Full") { return green; }
        if (s == "Battery fault" || s == "Thermal fault") { return red; }
        return text-tertiary;
    }

    public pure function bar-color(has-percent: bool, s: string, p: int) -> color {
        if (!has-percent) { return track; }
        if (s == "Battery fault" || s == "Thermal fault") { return red; }
        if (p <= 20) { return red; }
        if (p <= 30) { return amber; }
        if (s == "Charging" || s == "Slow charging" || s == "Almost full" || s == "Full") { return blue; }
        return green;
    }
}

component Badge inherits Rectangle {
    in property <string> label;
    in property <color> tint: Tokens.text-secondary;

    height: 20px;
    width: badge-text.preferred-width + 16px;
    border-radius: 10px;
    background: tint.with-alpha(0.14);
    border-width: 1px;
    border-color: tint.with-alpha(0.28);

    badge-text := Text {
        text: label;
        font-size: 10px;
        font-weight: 700;
        color: tint;
        letter-spacing: 0.4px;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: 100%;
    }
}

/// The device-kind glyph that leads each row. Drawn from primitives so the app ships no icon
/// assets and the shape scales with the row: outlines are Rectangles, the headset band is a
/// Path, and circles are Rectangles with a radius of half their side.
component DeviceGlyph inherits Rectangle {
    in property <string> kind;
    in property <color> tint: Tokens.text-secondary;

    width: 24px;
    height: 24px;
    background: transparent;

    if (kind == "Mouse") : Rectangle {
        background: transparent;
        Rectangle {
            x: 7px; y: 2.5px; width: 10px; height: 19px; border-radius: 5px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 11.2px; y: 5.5px; width: 1.6px; height: 5px; border-radius: 0.8px; background: tint; }
    }
    if (kind == "Keyboard") : Rectangle {
        background: transparent;
        Rectangle {
            x: 1px; y: 5px; width: 22px; height: 14px; border-radius: 3px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 4.5px; y: 9px; width: 15px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 4.5px; y: 13px; width: 3px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 10.5px; y: 13px; width: 3px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 16.5px; y: 13px; width: 3px; height: 1.6px; border-radius: 0.8px; background: tint; }
    }
    if (kind == "Headset") : Rectangle {
        background: transparent;
        Path {
            commands: "M 3 15 Q 12 3 21 15";
            stroke: tint;
            stroke-width: 2px;
            fill: transparent;
        }
        Rectangle { x: 1.5px; y: 13px; width: 4.5px; height: 7.5px; border-radius: 2.2px; background: tint; }
        Rectangle { x: 18px; y: 13px; width: 4.5px; height: 7.5px; border-radius: 2.2px; background: tint; }
    }
    if (kind == "Trackball") : Rectangle {
        background: transparent;
        Rectangle {
            x: 3px; y: 3px; width: 18px; height: 18px; border-radius: 9px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 9.5px; y: 9.5px; width: 5px; height: 5px; border-radius: 2.5px; background: tint; }
    }
    if (kind == "Touchpad") : Rectangle {
        background: transparent;
        Rectangle {
            x: 2px; y: 4.5px; width: 20px; height: 15px; border-radius: 3px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 6px; y: 15px; width: 12px; height: 1.6px; border-radius: 0.8px; background: tint; }
    }
    if (kind == "Numpad") : Rectangle {
        background: transparent;
        Rectangle {
            x: 5px; y: 2.5px; width: 14px; height: 19px; border-radius: 3px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        // Three rows of two keys, drawn explicitly: a nested `for` is not expressible in one
        // `if` branch, and six rectangles read better than a loop here anyway.
        Rectangle { x: 8px; y: 6px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 13px; y: 6px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 8px; y: 11px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 13px; y: 11px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 8px; y: 16px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
        Rectangle { x: 13px; y: 16px; width: 2.6px; height: 2.6px; border-radius: 1.3px; background: tint; }
    }
    if (kind == "Presenter") : Rectangle {
        background: transparent;
        Rectangle {
            x: 7.5px; y: 2.5px; width: 9px; height: 19px; border-radius: 4.5px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 10px; y: 7px; width: 4px; height: 1.6px; border-radius: 0.8px; background: tint; }
        Rectangle { x: 10px; y: 15px; width: 4px; height: 2.6px; border-radius: 1.3px; background: tint; }
    }
    if (kind == "Remote") : Rectangle {
        background: transparent;
        Rectangle {
            x: 7.5px; y: 2.5px; width: 9px; height: 19px; border-radius: 4.5px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
        Rectangle { x: 10.4px; y: 6px; width: 3.2px; height: 3.2px; border-radius: 1.6px; background: tint; }
        Rectangle { x: 10.4px; y: 12px; width: 3.2px; height: 3.2px; border-radius: 1.6px; background: tint; }
    }
    // Anything we cannot name yet gets a plain box rather than a guessed shape.
    if (kind == "Device" || kind == "") : Rectangle {
        background: transparent;
        Rectangle {
            x: 4px; y: 4px; width: 16px; height: 16px; border-radius: 4px;
            background: transparent; border-width: 1.6px; border-color: tint;
        }
    }
}

component BatteryBar inherits Rectangle {
    in property <int> percent;
    in property <color> fill-color: Tokens.green;

    height: 6px;
    border-radius: 3px;
    background: Tokens.track;

    // `x: 0` is load-bearing: a child Rectangle that sets only `width` is centred inside its
    // parent, which makes a progress bar shrink from both ends instead of from the right.
    Rectangle {
        x: 0;
        y: 0;
        width: max(0px, parent.width * percent / 100);
        height: parent.height;
        border-radius: 3px;
        background: fill-color;
    }
}

component DeviceRow inherits Rectangle {
    in property <Device> device;
    in property <bool> is-selected: false;
    callback pick;
    callback snooze;

    height: 96px;
    border-radius: 12px;
    background: device.attention
        ? (is-selected ? Tokens.alert-surface-raised : Tokens.alert-surface)
        : (is-selected ? Tokens.surface-raised : Tokens.surface);
    border-width: 1px;
    border-color: device.attention
        ? Tokens.red.with-alpha(0.35)
        : (is-selected ? Tokens.accent.with-alpha(0.55) : Tokens.border-subtle);
    animate background, border-color { duration: 120ms; }

    // Declared before the content so the Snooze button keeps its own clicks.
    row-click := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pick(); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        cross-axis-alignment: center;

        Rectangle {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: Tokens.conn-color(device.connection).with-alpha(0.13);
            border-width: 1px;
            border-color: Tokens.conn-color(device.connection).with-alpha(0.25);

            DeviceGlyph {
                kind: device.kind;
                tint: Tokens.conn-color(device.connection);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            alignment: center;

            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                Text {
                    text: device.name;
                    font-size: 14px;
                    font-weight: 600;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Badge {
                    label: device.connection;
                    tint: Tokens.conn-color(device.connection);
                }

                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: 10px;
                cross-axis-alignment: center;

                BatteryBar {
                    horizontal-stretch: 1;
                    percent: max(0, device.percent);
                    fill-color: Tokens.bar-color(device.has-percent, device.status, device.percent);
                }

                Text {
                    text: device.percent-text;
                    width: 52px;
                    font-size: 12px;
                    font-weight: 600;
                    color: device.attention ? Tokens.red : Tokens.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Tokens.status-color(device.status);
                }

                Text {
                    text: device.status;
                    font-size: 12px;
                    color: Tokens.status-color(device.status);
                    vertical-alignment: center;
                }

                Text {
                    text: device.kind;
                    font-size: 12px;
                    color: Tokens.text-tertiary;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Text {
                    text: device.updated;
                    font-size: 11px;
                    color: Tokens.text-tertiary;
                    vertical-alignment: center;
                }
            }
        }

        Button {
            text: "Snooze";
            width: 78px;
            height: 28px;
            clicked => { root.snooze(); }
        }
    }
}

component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Tokens.text-primary;

    height: 60px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: Tokens.surface-raised;
    border-width: 1px;
    border-color: Tokens.border-subtle;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 3px;
        alignment: center;

        Text {
            text: label;
            font-size: 10px;
            font-weight: 600;
            color: Tokens.text-tertiary;
            letter-spacing: 0.5px;
        }

        Text {
            text: value;
            font-size: 15px;
            font-weight: 600;
            color: value-color;
            overflow: elide;
        }
    }
}

component DetailLine inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 26px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        Text {
            text: label;
            width: 108px;
            font-size: 12px;
            color: Tokens.text-tertiary;
            vertical-alignment: center;
        }

        Text {
            text: value;
            font-size: 12px;
            color: Tokens.text-primary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> with-switch: false;
    /// Give this a label to put a button on the right instead of a value or a switch.
    in property <string> button-text: "";
    in-out property <bool> toggled: false;
    callback changed(bool);
    callback acted;

    height: 44px;
    border-radius: 10px;
    background: Tokens.surface-raised;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        Text {
            text: title;
            font-size: 13px;
            color: Tokens.text-primary;
            vertical-alignment: center;
        }

        Rectangle { horizontal-stretch: 1; }

        if with-switch: Switch {
            checked <=> root.toggled;
            toggled => { root.changed(self.checked); }
        }

        if !with-switch && button-text == "": Text {
            text: value;
            font-size: 13px;
            color: Tokens.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        if !with-switch && button-text != "": Button {
            text: root.button-text;
            width: 128px;
            height: 28px;
            clicked => { root.acted(); }
        }
    }
}

/// The small grey label a settings page groups its rows under.
component SectionLabel inherits Text {
    font-size: 10px;
    font-weight: 700;
    color: Tokens.text-tertiary;
    letter-spacing: 0.6px;
}

/// A settings row whose value the user moves rather than reads.
component NumberRow inherits Rectangle {
    in property <string> title;
    in property <string> caption;
    in property <int> minimum: 5;
    in property <int> maximum: 600;
    in property <int> step: 5;
    in-out property <int> number: 60;
    callback numbered(int);

    height: 44px;
    border-radius: 10px;
    background: Tokens.surface-raised;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: root.title;
                font-size: 13px;
                color: Tokens.text-primary;
            }

            Text {
                text: root.caption;
                font-size: 10px;
                color: Tokens.text-tertiary;
                overflow: elide;
            }
        }

        SpinBox {
            width: 116px;
            height: 28px;
            minimum: root.minimum;
            maximum: root.maximum;
            step-size: root.step;
            value <=> root.number;
            edited(v) => { root.numbered(v); }
        }
    }
}

/// The sentence under a settings row that says what the row above it means.
component Caption inherits Text {
    font-size: 10px;
    color: Tokens.text-tertiary;
    wrap: word-wrap;
}

/// The alert level of the selected device: the one setting in this window that is about one
/// device rather than the application, so it is edited here and its state says whose it is.
component AlertLevelRow inherits Rectangle {
    in property <string> default-text;
    in property <bool> custom: false;
    in-out property <int> level: 20;
    callback leveled(int);
    callback cleared();

    height: 44px;
    border-radius: 10px;
    background: Tokens.surface-raised;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 1px;
            alignment: center;

            Text {
                text: "Low battery alert";
                font-size: 13px;
                color: Tokens.text-primary;
            }

            // Whose level this is, in the row itself: a setting that belongs to one device is
            // otherwise indistinguishable from the shared ones below it.
            Text {
                text: root.custom ? "set for this device" : root.default-text;
                font-size: 10px;
                color: root.custom ? Tokens.accent : Tokens.text-tertiary;
                overflow: elide;
            }
        }

        SpinBox {
            width: 116px;
            height: 28px;
            minimum: 5;
            maximum: 95;
            step-size: 5;
            value <=> root.level;
            edited(v) => { root.leveled(v); }
        }

        Button {
            text: "Default";
            width: 78px;
            height: 28px;
            // Nothing to go back to when this device is already on the shared thresholds.
            enabled: root.custom;
            clicked => { root.cleared(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Embr — Logitech devices";
    // Noto Sans is what `sans-serif` resolves to on the major distributions, so the window looks
    // native wherever it runs and needs no font shipping. If a system does not have it, Slint
    // falls back to that system's own default.
    default-font-family: "Noto Sans";
    icon: @image-url("../../../assets/embr.svg");
    width: 1000px;
    // Tall enough for the detail card and every settings row, with slack: a `Window` with a
    // fixed height clips whatever does not fit and says nothing about it.
    height: 660px;
    background: Tokens.bg;

    in property <[Device]> devices;
    in-out property <Device> selected;
    in property <bool> has-devices: false;
    in property <string> last-updated-label: "";
    in property <bool> refreshing: false;
    in-out property <bool> notifications-enabled: false;
    in property <string> thresholds-text: "";
    /// Seconds between the sweeps the window asks for while it is open. Rust clamps this to
    /// 5–600 before it lands here, and `core::scheduled_interval` is what does the counting.
    in-out property <int> refresh-seconds: 60;
    in property <string> notice: "";
    in-out property <int> selected-index: -1;
    /// The selected device's alert level, and whether it is one the user set for it.
    in-out property <int> alert-level: 20;
    in property <bool> alert-custom: false;
    in-out property <bool> tray-percent: false;
    /// Keep running (tray only) when the window is closed, or quit instead.
    in-out property <bool> close-to-tray: true;
    /// Where the settings on the settings page are written, so the page can say so.
    in property <string> config-path: "";
    /// Which page is showing: 0 is the devices, 1 is the settings. This one is the window's
    /// own; nothing outside decides it.
    in-out property <int> view: 0;

    callback tick();
    /// Read every device now, with the longer waits a device that has been asleep needs.
    callback rescan();
    callback pick(int);
    callback snooze(string);
    callback notifications-toggled(bool);
    callback alert-level-changed(int);
    callback alert-level-cleared();
    callback tray-percent-toggled(bool);
    callback close-to-tray-toggled(bool);
    callback refresh-seconds-changed(int);
    callback quit-requested();
    callback show-about();

    // The tick does all the timing: it drains what the device thread produced, keeps the ages
    // honest and decides when the next scheduled sweep is due. The cadence itself is
    // `core::scheduled_interval`, and the number lives in the settings.
    Timer {
        interval: 500ms;
        running: true;
        triggered => { root.tick(); }
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        // ---- header ----
        HorizontalLayout {
            height: 66px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 14px;
            cross-axis-alignment: center;

            // The mark and the wordmark read as one unit, so they sit closer to each other than the
            // header's own spacing. Nothing else belongs up here: a summary line next to the
            // window's own name was noise on top of the list right below it.
            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("../../../assets/embr.svg");
                    width: 22px;
                    height: 22px;
                    image-fit: contain;
                }

                Text {
                    text: "Embr";
                    font-size: 20px;
                    font-weight: 700;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Two pages: what the devices are doing, and how the app behaves. The active one
            // is filled, which is the only thing that says which page you are looking at.
            Button {
                text: "Devices";
                width: 92px;
                height: 30px;
                primary: root.view == 0;
                clicked => { root.view = 0; }
            }

            Button {
                text: "Settings";
                width: 92px;
                height: 30px;
                primary: root.view == 1;
                clicked => { root.view = 1; }
            }

            Button {
                text: root.refreshing ? "Rescanning…" : "Rescan";
                width: 116px;
                height: 30px;
                clicked => { root.rescan(); }
            }

            Button {
                text: "About";
                width: 84px;
                height: 30px;
                clicked => { root.show-about(); }
            }
        }

        Rectangle { height: 1px; background: Tokens.border-subtle; }

        // ---- body ----
        //
        // `if` rather than `visible:`: an invisible layout child is still laid out, which put
        // the settings page below the devices page instead of in its place.
        if root.view == 0: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 20px;

            // left: the device list
            VerticalLayout {
                width: 470px;
                vertical-stretch: 1;
                spacing: 10px;

                HorizontalLayout {
                    height: 18px;
                    cross-axis-alignment: center;

                    Text {
                        text: "DEVICES";
                        font-size: 10px;
                        font-weight: 700;
                        color: Tokens.text-tertiary;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.refreshing ? "scanning…" : root.last-updated-label;
                        font-size: 11px;
                        color: Tokens.text-tertiary;
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 10px;

                        for d[i] in root.devices: DeviceRow {
                            device: d;
                            is-selected: i == root.selected-index;
                            pick => { root.pick(i); }
                            snooze => { root.snooze(d.key); }
                        }

                        if !root.has-devices: Rectangle {
                            height: 96px;
                            border-radius: 12px;
                            background: Tokens.surface;
                            border-width: 1px;
                            border-color: Tokens.border-subtle;

                            Text {
                                text: root.refreshing
                                    ? "Scanning for Logitech devices…"
                                    : "No Logitech devices found.";
                                font-size: 13px;
                                color: Tokens.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // right: details, then settings
            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 16px;

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 14px;
                    background: Tokens.surface;
                    border-width: 1px;
                    border-color: Tokens.border-subtle;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000055;
                    drop-shadow-offset-y: 4px;

                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 18px;
                        padding-bottom: 18px;
                        spacing: 14px;

                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 46px;
                                height: 46px;
                                border-radius: 12px;
                                background: Tokens.accent.with-alpha(0.14);
                                border-width: 1px;
                                border-color: Tokens.accent.with-alpha(0.28);

                                DeviceGlyph {
                                    kind: root.selected.kind;
                                    tint: Tokens.accent;
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: root.has-devices ? root.selected.name : "No device selected";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Tokens.text-primary;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.has-devices ? root.selected.kind : "—";
                                    font-size: 12px;
                                    color: Tokens.text-tertiary;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.has-devices: Badge {
                                label: root.selected.connection;
                                tint: Tokens.conn-color(root.selected.connection);
                            }
                        }

                        Rectangle { height: 1px; background: Tokens.border-subtle; }

                        HorizontalLayout {
                            spacing: 10px;

                            StatTile {
                                label: "BATTERY";
                                value: root.selected.percent-text;
                                value-color: root.selected.attention
                                    ? Tokens.red
                                    : Tokens.bar-color(root.selected.has-percent, root.selected.status, root.selected.percent);
                            }

                            StatTile {
                                label: "VOLTAGE";
                                value: root.selected.millivolts > 0 ? "\{root.selected.millivolts} mV" : "—";
                            }

                            StatTile {
                                label: "UPDATED";
                                value: root.selected.updated;
                            }
                        }

                        BatteryBar {
                            percent: max(0, root.selected.percent);
                            fill-color: Tokens.bar-color(root.selected.has-percent, root.selected.status, root.selected.percent);
                        }

                        // Status is the one field the stat tiles above do not already carry;
                        // connection is the badge next to the title, and voltage is the tile,
                        // so repeating them here just makes the card noisy.
                        DetailLine { label: "Status"; value: root.selected.status; }
                        if (root.has-devices && root.selected.error != "") : DetailLine {
                            label: "Reported";
                            value: root.selected.error;
                        }

                        Rectangle { height: 1px; background: Tokens.border-subtle; }

                        SectionLabel { text: "ALERT FOR THIS DEVICE"; }

                        if root.has-devices: AlertLevelRow {
                            default-text: "shared: " + root.thresholds-text;
                            custom: root.alert-custom;
                            level <=> root.alert-level;
                            leveled(v) => { root.alert-level-changed(v); }
                            cleared => { root.alert-level-cleared(); }
                        }

                        Caption {
                            text: "Every other setting — notifications, the tray icon, what closing the window does — is on the Settings page.";
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }
        }

        // ---- the settings page ----
        //
        // The devices page is about what the hardware is doing; this one is about the app.
        // Scrolled rather than stretched, so a setting added later pushes the page down instead
        // of pushing rows out of the window.
        if root.view == 1: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 0;

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                width: 640px;
                vertical-stretch: 1;

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 10px;

                        SectionLabel { text: "NOTIFICATIONS"; }

                        SettingRow {
                            title: "Battery notifications";
                            with-switch: true;
                            toggled <=> root.notifications-enabled;
                            changed(v) => { root.notifications-toggled(v); }
                        }

                        SettingRow {
                            title: "Shared thresholds";
                            value: root.thresholds-text;
                        }

                        Caption {
                            text: "A device with a level of its own watches that instead — set it beside the device itself, on the Devices page.";
                        }

                        SectionLabel { text: "WINDOW"; }

                        SettingRow {
                            title: "Close to tray";
                            with-switch: true;
                            toggled <=> root.close-to-tray;
                            changed(v) => { root.close-to-tray-toggled(v); }
                        }

                        Caption {
                            text: "Closing the window leaves Embr running: the devices are still read, and a low battery is still announced. Turn this off to quit instead.";
                        }

                        SettingRow {
                            title: "Stop watching now";
                            value: "Quits Embr and takes the tray item with it";
                            button-text: "Quit Embr";
                            acted => { root.quit-requested(); }
                        }

                        SectionLabel { text: "TRAY"; }

                        SettingRow {
                            title: "Tray icon shows the level";
                            with-switch: true;
                            toggled <=> root.tray-percent;
                            changed(v) => { root.tray-percent-toggled(v); }
                        }

                        Caption {
                            text: "Embr registers its tray item as “embr”: some bars draw only the items they have pinned. Closing the window is the fastest way to a tray-only app.";
                        }

                        SectionLabel { text: "APPLICATION"; }

                        NumberRow {
                            title: "Refresh interval";
                            caption: "while the window is open";
                            minimum: 5;
                            maximum: 600;
                            step: 5;
                            number <=> root.refresh-seconds;
                            numbered(v) => { root.refresh-seconds-changed(v); }
                        }

                        Caption {
                            text: "With the window closed Embr slows down to a read every two minutes; it reads everything the moment the window comes back. Rescan reads now, and gives a device that has been asleep longer to answer.";
                        }

                        SettingRow {
                            title: "Settings file";
                            value: root.config-path;
                        }

                        Caption {
                            text: "Written as you change things here. The thresholds and the per-device levels live in it too, so it can be edited by hand while Embr runs.";
                        }

                        if root.notice != "": Caption {
                            text: root.notice;
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }
    }
}

/// The About view. The `AboutSlint` widget is required by the Slint licence and is shown
/// here rather than buried, because this build really does use Slint under the hood.
export component AboutWindow inherits Window {
    title: "About Embr";
    default-font-family: "Noto Sans";
    icon: @image-url("../../../assets/embr.svg");
    width: 460px;
    // Tall enough for the mark, three lines of text, the Slint attribution and the button.
    height: 420px;
    background: Tokens.bg;

    callback close-requested();

    VerticalLayout {
        padding: 26px;
        spacing: 12px;
        alignment: center;

        Image {
            source: @image-url("../../../assets/embr.svg");
            width: 100%;
            height: 72px;
            image-fit: contain;
            // The layout stretches children across its cross axis, so the mark needs to say where
            // it sits inside that width.
            horizontal-alignment: center;
        }

        Text {
            text: "Embr";
            font-size: 22px;
            font-weight: 700;
            color: Tokens.text-primary;
            horizontal-alignment: center;
        }

        Text {
            text: "A battery monitor for Logitech devices on Linux.";
            font-size: 13px;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: "Reads the devices directly over HID++ and shows what they report — charge, voltage, connection state and the device list.";
            font-size: 12px;
            color: Tokens.text-tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        AboutSlint { }

        // A layout positions a fixed-width child at the start of its cross axis, so the button is
        // centred inside a full-width strip instead of stretching to the whole dialog.
        Rectangle {
            height: 30px;
            background: transparent;

            Button {
                text: "Close";
                width: 96px;
                height: 30px;
                x: (parent.width - self.width) / 2;
                clicked => { root.close-requested(); }
            }
        }
    }
}
